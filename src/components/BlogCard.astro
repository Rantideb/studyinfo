---
import { Calendar, User, ArrowRight } from "lucide-astro";

interface Props {
  id: string;
  title: string;
  slug: string;
  excerpt: string;
  author: string;
  date: string;
  category: string;
  image: string;
  readTime: string;
}

const {
  id,
  title,
  slug,
  excerpt,
  author,
  date,
  category,
  image,
  readTime,
} = Astro.props;
---

<article class="blog-card" data-post-id={id}>
  <div class="image-container">
    <img src={image} alt={title} class="card-image" />
  </div>

  <div class="card-content">
    <div class="card-meta-top">
      <span class="category-badge">{category}</span>
      <span class="read-time">{readTime}</span>
    </div>

    <h3 class="card-title">
      <a href={`/blog/${slug}`} class="card-link">{title}</a>
    </h3>

    <p class="card-excerpt">{excerpt}</p>

    <div class="card-footer">
      <div class="card-meta-bottom">
        <span class="author-label">by</span>
        <span class="author-name">{author}</span>
        <span class="meta-divider">•</span>
        <span class="author-date">{date}</span>
      </div>

      <a href={`/blog/${slug}`} class="read-more-btn" aria-label={`Read article: ${title}`}>
        <span>Read article</span>
        <ArrowRight class="read-more-icon" />
      </a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    background-color: var(--card-bg);
    border-radius: 0px;
    border: 1px solid var(--image-frame);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .blog-card:hover {
    border-color: var(--jelly-mint);
  }

  .image-container {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
    border-bottom: 1px solid var(--image-frame);
  }
  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-card:hover .card-image {
    transform: scale(1.04);
  }

  .card-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .category-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--jelly-mint);
  }
  .read-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--secondary-text);
    letter-spacing: 0.5px;
  }

  .card-title {
    font-family: var(--font-ui);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--hazard-white);
    margin-bottom: 0.75rem;
    line-height: 1.3;
    transition: color 0.15s ease;
  }
  .card-link {
    text-decoration: none;
    color: inherit;
  }
  .blog-card:hover .card-title {
    color: var(--deep-link-blue);
  }

  .card-excerpt {
    font-family: var(--font-ui);
    color: var(--secondary-text);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--image-frame);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-meta-bottom {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--secondary-text);
    letter-spacing: 0.5px;
  }

  .author-label {
    opacity: 0.6;
  }

  .author-name {
    color: var(--hazard-white);
    font-weight: 600;
  }

  .meta-divider {
    color: var(--image-frame);
    margin: 0 0.1rem;
  }

  .author-date {
    opacity: 0.8;
  }

  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--jelly-mint);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-decoration: none;
    transition: color 0.15s ease;
    flex-shrink: 0;
  }
  .blog-card:hover .read-more-btn {
    color: var(--hazard-white);
  }

  .read-more-icon {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.2s;
  }
  .blog-card:hover .read-more-icon {
    transform: translateX(4px);
  }
</style>
