---
import { Calendar, User, ArrowRight } from "lucide-astro";

interface Props {
  id: string;
  title: string;
  slug: string;
  excerpt: string;
  author: string;
  date: string;
  category: string;
  image: string;
  readTime: string;
}

const {
  id,
  title,
  slug,
  excerpt,
  author,
  date,
  category,
  image,
  readTime,
} = Astro.props;
---

<article class="blog-card" data-post-id={id}>
  <div class="image-container">
    <img src={image} alt={title} class="card-image" />
  </div>

  <div class="card-content">
    <div class="card-meta-top">
      <span class="category-badge">{category}</span>
      <span class="read-time">{readTime}</span>
    </div>

    <h3 class="card-title">
      <a href={`/blog/${slug}`} class="card-link">{title}</a>
    </h3>

    <p class="card-excerpt">{excerpt}</p>

    <div class="card-footer">
      <div class="card-author">
        <div class="author-info">
          <User class="author-icon" />
          <span class="author-name">{author}</span>
        </div>
        <div class="author-date">
          <Calendar class="author-icon" />
          <span>{date}</span>
        </div>
      </div>

      <a href={`/blog/${slug}`} class="read-more-btn">
        <span>Read article</span>
        <ArrowRight class="read-more-icon" />
      </a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    background-color: #ffffff;
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    border: 1px solid #f1f5f9;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    border-color: #e2e8f0;
  }

  .image-container {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
  }
  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .blog-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .category-badge {
    padding: 0.25rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    color: #2563eb;
    background-color: #eff6ff;
    border-radius: 9999px;
  }
  .read-time {
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 500;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.75rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s;
  }
  .blog-card:hover .card-link {
    color: #2563eb;
  }

  .card-excerpt {
    color: #475569;
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid #f1f5f9;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0; /* allows text truncation if needed */
  }

  .author-info, .author-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: #64748b;
    white-space: nowrap;
  }

  .author-name {
    font-weight: 500;
    color: #334155;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
  }

  .author-icon {
    width: 0.875rem;
    height: 0.875rem;
    opacity: 0.7;
  }

  .read-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #2563eb;
    font-weight: 600;
    font-size: 0.8125rem;
    text-decoration: none;
    transition: all 0.2s;
    padding: 0.5rem 0.75rem;
    background-color: #f8fafc;
    border-radius: 0.5rem;
    border: 1px solid transparent;
  }

  .read-more-btn:hover {
    background-color: #eff6ff;
    transform: translateX(2px);
    border-color: #dbeafe;
  }

  .read-more-icon {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 0.2s;
  }
  .read-more-btn:hover .read-more-icon {
    transform: translateX(2px);
  }
</style>
