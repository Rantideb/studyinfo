---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";

const allPosts = await getCollection("blog");
// Sort by date (descending)
const featuredPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<section class="featured-section">
  <div class="container">
    <div class="header">
      <h2 class="title">Latest from the Backbench</h2>
      <p class="subtitle">Practical guides and honest advice for your study abroad journey.</p>
    </div>

    <div class="grid stagger-container">
      {featuredPosts.map((post) => (
        <BlogCard {...post.data} slug={post.id} id={post.id} />
      ))}
    </div>

    <div class="view-all-wrapper">
      <a href="/blog" class="btn-view-all">View All Articles</a>
    </div>
  </div>
</section>

<script>
  function initFeaturedAnimations() {
    // Simple intersection observer for stagger effect
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
    );

    document.querySelectorAll(".blog-card").forEach((el, index) => {
      // Add staggered delay
      (el as HTMLElement).style.transitionDelay = `${index * 0.1}s`;
      observer.observe(el);
    });
  }

  // Run on initial load and after every navigation
  document.addEventListener('astro:page-load', initFeaturedAnimations);
</script>

<style>
  .featured-section {
    padding: 4rem 0;
    background-color: var(--canvas-black);
    border-bottom: 1px solid var(--image-frame);
  }
  .container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px) {
    .container { padding: 0 1.5rem; }
  }
  @media (min-width: 1024px) {
    .container { padding: 0 2rem; }
  }

  .header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .title {
    font-family: var(--font-ui);
    font-size: 2.5rem;
    line-height: 1.15;
    letter-spacing: 1.07px;
    color: var(--hazard-white);
    margin-bottom: 1rem;
  }
  @media (min-width: 1024px) {
    .title {
      font-size: 3.5rem;
    }
  }
  .subtitle {
    font-family: var(--font-ui);
    font-size: 1.25rem;
    color: var(--muted-text);
    max-width: 42rem;
    margin: 0 auto;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Note: post-card styles are inside BlogCard.astro, keeping stagger animation classes */
  .stagger-container .blog-card {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .stagger-container .blog-card.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .view-all-wrapper {
    margin-top: 3rem;
    text-align: center;
  }
  .btn-view-all {
    display: inline-block;
    background-color: transparent;
    color: var(--jelly-mint);
    border: 1px solid var(--jelly-mint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 10px 24px;
    border-radius: 0px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .btn-view-all:hover {
    background-color: var(--jelly-mint);
    color: var(--inverted-text);
  }
</style>
