---
import Logo from "./Logo.astro";
import { BookOpen, Facebook, Twitter, Instagram, Mail } from "lucide-astro";
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      
      <div class="footer-brand">
        <div class="brand-logo">
          <Logo textClassName="logo-text-white" />
        </div>
        <p class="brand-description">
          Study abroad guidance for average students and backbenchers. No judgment, just results.
        </p>
        <div class="social-links">
          <a href="#" class="social-link" aria-label="Facebook">
            <Facebook class="icon" />
          </a>
          <a href="#" class="social-link" aria-label="Twitter">
            <Twitter class="icon" />
          </a>
          <a href="#" class="social-link" aria-label="Instagram">
            <Instagram class="icon" />
          </a>
          <a href="#" class="social-link" aria-label="Email">
            <Mail class="icon" />
          </a>
        </div>
      </div>

      <div class="footer-links">
        <h3 class="links-title">Quick Links</h3>
        <ul class="links-list">
          <li><a href="/blog" class="link-item">All Articles</a></li>
          <li><a href="/scholarships" class="link-item">Scholarships</a></li>
          <li><a href="/resources" class="link-item">Resources</a></li>
          <li><a href="/about" class="link-item">About Us</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3 class="links-title">Legal</h3>
        <ul class="links-list">
          <li><a href="/privacy" class="link-item">Privacy Policy</a></li>
          <li><a href="/terms" class="link-item">Terms of Service</a></li>
          <li><a href="/cookies" class="link-item">Cookie Policy</a></li>
          <li><a href="/contact" class="link-item">Contact</a></li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} Studyinfo. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #0f172a; /* slate-900 */
    color: #ffffff;
  }
  .footer-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
  .brand-logo {
    margin-bottom: 1rem;
  }
  /* Since Logo is a component, we use global or just pass it in */
  :global(.logo-text-white) {
    color: #ffffff !important;
  }
  .brand-description {
    color: #cbd5e1; /* slate-300 */
    margin-bottom: 1rem;
    max-width: 28rem;
    line-height: 1.5;
  }
  .social-links {
    display: flex;
    gap: 1rem;
  }
  .social-link {
    color: #94a3b8; /* slate-400 */
    transition: color 0.2s;
  }
  .social-link:hover {
    color: #3b82f6; /* brand-accent */
  }
  .icon {
    width: 1.25rem;
    height: 1.25rem;
  }
  .links-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #ffffff;
  }
  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .link-item {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s;
  }
  .link-item:hover {
    color: #3b82f6;
  }
  .footer-bottom {
    border-top: 1px solid #334155; /* slate-700 */
    margin-top: 2rem;
    padding-top: 2rem;
    text-align: center;
  }
  .copyright {
    color: #94a3b8;
  }
</style>
