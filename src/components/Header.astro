---
import Logo from "./Logo.astro";
import { Menu, X } from "lucide-astro";

const pathname = Astro.url.pathname;

const navigation = [
  { name: "Home", href: "/" },
  { name: "Study Tips", href: "/study-tips" },
  { name: "Scholarships", href: "/scholarships" },
  { name: "Resources", href: "/resources" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];

const isActive = (path: string) => {
  if (path === "/" && pathname !== "/") return false;
  return pathname.startsWith(path);
};
---

<header class="site-header">
  <div class="header-container">
    <div class="nav-wrapper">
      <a href="/" class="logo-link">
        <Logo />
      </a>

      <nav class="desktop-nav">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? "active" : ""}`}
            >
              {item.name}
            </a>
          ))
        }
      </nav>

      <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="Toggle menu">
        <Menu class="icon icon-menu" />
        <X class="icon icon-close" style="display: none;" />
      </button>
    </div>

    <div id="mobile-menu" class="mobile-menu" style="display: none;">
      <nav class="mobile-nav">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              class={`mobile-link ${isActive(item.href) ? "active" : ""}`}
            >
              {item.name}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconMenu = toggleBtn?.querySelector(".icon-menu");
    const iconClose = toggleBtn?.querySelector(".icon-close");

    toggleBtn?.addEventListener("click", () => {
      const isHidden = mobileMenu?.style.display === "none";
      if (mobileMenu) mobileMenu.style.display = isHidden ? "block" : "none";
      
      if (iconMenu && iconClose) {
        if (isHidden) {
          iconMenu.setAttribute("style", "display: none;");
          iconClose.setAttribute("style", "display: block;");
        } else {
          iconMenu.setAttribute("style", "display: block;");
          iconClose.setAttribute("style", "display: none;");
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .site-header {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .nav-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 4rem;
  }
  .logo-link {
    text-decoration: none;
  }
  .desktop-nav {
    display: none;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }
  }
  .nav-link {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #334155;
    text-decoration: none;
    transition: all 0.2s ease-in-out;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover {
    color: #2563eb;
    transform: scale(1.05);
  }
  .nav-link.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
  }
  .mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #334155;
    border-radius: 0.375rem;
  }
  .mobile-toggle:hover {
    background-color: #f1f5f9;
    color: #2563eb;
  }
  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }
  .icon {
    width: 1.5rem;
    height: 1.5rem;
  }
  .mobile-menu {
    padding: 1rem 0;
    border-top: 1px solid #e2e8f0;
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .mobile-link {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #334155;
    text-decoration: none;
    border-radius: 0.375rem;
  }
  .mobile-link:hover {
    color: #2563eb;
    background-color: #f8fafc;
  }
  .mobile-link.active {
    color: #2563eb;
    background-color: #eff6ff;
  }
</style>
