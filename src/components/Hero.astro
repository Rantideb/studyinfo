---
import { BookOpen, Award, Users } from "lucide-astro";
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-grid">
      
      <div class="hero-content reveal-on-scroll">
        <div class="hero-kicker">Study Abroad Guide</div>
        <h1 class="hero-title">
          Not only for <span class="text-accent">toppers</span>.
        </h1>
        <p class="hero-subtitle">
          Average grades? Backlogs? Confused? You are in the right place.
          We provide honest, step-by-step guidance for backbenchers who dream of studying in the UK, Canada, and Europe.
        </p>

        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">
            START READING GUIDE
          </a>
          <a href="/scholarships" class="btn btn-outline">
            FIND SCHOLARSHIPS
          </a>
        </div>
      </div>

      <div class="hero-image-wrapper">
        <img
          src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
          alt="Students studying together"
          class="hero-image"
        />
        
        <div class="stats-card">
          <div class="stats-text">
            <p class="stats-number">10,000+</p>
            <p class="stats-label">STUDENTS HELPED</p>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  function initHeroAnimations() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
    );

    document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
      observer.observe(el);
    });
  }

  // Run on initial load and after every navigation
  document.addEventListener('astro:page-load', initHeroAnimations);
</script>

<style>
  .hero-section {
    background-color: var(--canvas-black);
    padding: 4rem 0;
    border-bottom: 1px solid var(--image-frame);
  }
  @media (min-width: 1024px) {
    .hero-section {
      padding: 6rem 0;
    }
  }

  .hero-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hero-kicker {
    font-family: var(--font-ui);
    font-size: 1.19rem;
    font-weight: 300;
    letter-spacing: 1.9px;
    color: var(--hazard-white);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-ui);
    font-size: 2.5rem;
    line-height: 1.15;
    letter-spacing: 1.07px;
    color: var(--hazard-white);
    margin-bottom: 1.5rem;
  }
  @media (min-width: 1024px) {
    .hero-title {
      font-size: 3.5rem;
    }
  }

  .text-accent {
    color: var(--jelly-mint);
  }

  .hero-subtitle {
    font-family: var(--font-ui);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--muted-text);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
    }
  }

  .btn-outline {
    display: inline-block;
    background-color: transparent;
    color: var(--jelly-mint);
    border: 1px solid var(--jelly-mint);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 10px 24px;
    border-radius: 0px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .btn-outline:hover {
    background-color: var(--jelly-mint);
    color: var(--inverted-text);
  }

  .hero-image-wrapper {
    position: relative;
    border: 1px solid var(--image-frame);
    border-radius: 0px;
    padding: 10px;
  }

  .hero-image {
    width: 100%;
    border-radius: 0px;
    display: block;
  }

  .stats-card {
    position: absolute;
    bottom: -1.5rem;
    left: -1.5rem;
    background-color: var(--verge-ultraviolet);
    padding: 1rem 1.5rem;
    border-radius: 0px;
    border: 1px solid var(--absolute-white);
    display: flex;
    align-items: center;
  }

  .stats-text {
    display: flex;
    flex-direction: column;
  }
  .stats-number {
    font-family: var(--font-ui);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--absolute-white);
    margin: 0;
  }
  .stats-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 1.5px;
    color: var(--absolute-white);
    margin: 0;
  }

  /* Scroll Reveal animation */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .reveal-on-scroll.revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>
