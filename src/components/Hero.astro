---
import { BookOpen, Award, Users } from "lucide-astro";
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-grid">
      
      <div class="hero-content reveal-on-scroll">
        <h1 class="hero-title">
          Study Abroad Isn't Only for <span class="text-accent">Toppers</span>.
        </h1>
        <p class="hero-subtitle">
          Average grades? Backlogs? Confused? You are in the right place.
          We provide honest, step-by-step guidance for backbenchers who dream of studying in the UK, Canada, and Europe.
        </p>

        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">
            <BookOpen class="btn-icon" />
            Start Reading Guide
          </a>
          <a href="/scholarships" class="btn btn-outline">
            <Award class="btn-icon" />
            Find Scholarships
          </a>
        </div>

        <div class="hero-features">
          <div class="feature-item">
            <div class="feature-dot"></div>
            No Fake Promises
          </div>
          <div class="feature-item">
            <div class="feature-dot"></div>
            Realistic Advice
          </div>
        </div>
      </div>

      <div class="hero-image-wrapper">
        <img
          src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
          alt="Students studying together"
          class="hero-image"
        />
        
        <div class="stats-card">
          <div class="stats-icon-wrapper">
            <Users class="stats-icon" />
          </div>
          <div class="stats-text">
            <p class="stats-number">10,000+</p>
            <p class="stats-label">Students Helped</p>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  function initHeroAnimations() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
    );

    document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
      observer.observe(el);
    });
  }

  // Run on initial load and after every navigation
  document.addEventListener('astro:page-load', initHeroAnimations);
</script>

<style>
  .hero-section {
    background: linear-gradient(to bottom right, #eff6ff, #f1f5f9);
    padding: 4rem 0;
  }
  @media (min-width: 1024px) {
    .hero-section {
      padding: 6rem 0;
    }
  }

  .hero-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px) {
    .hero-container { padding: 0 1.5rem; }
  }
  @media (min-width: 1024px) {
    .hero-container { padding: 0 2rem; }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hero-title {
    font-size: 2.25rem;
    line-height: 2.5rem;
    font-weight: 700;
    color: #0f172a; /* slate-900 */
    margin-bottom: 1.5rem;
  }
  @media (min-width: 1024px) {
    .hero-title {
      font-size: 3.75rem;
      line-height: 1;
    }
  }

  .text-accent {
    color: #3b82f6; /* matched blue */
  }

  .hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.625;
    color: #475569; /* slate-600 */
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-weight: 500;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.5rem;
  }

  .btn-primary {
    background-color: #2563eb; /* blue-600 */
    color: #ffffff;
  }
  .btn-primary:hover {
    background-color: #1d4ed8; /* blue-700 */
  }

  .btn-outline {
    background-color: transparent;
    border: 1px solid #64748b;
    color: #64748b;
  }
  .btn-outline:hover {
    background-color: #eff6ff; /* blue-50 */
  }

  .hero-features {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: #64748b; /* slate-500 */
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
  }
  .feature-dot {
    width: 0.5rem;
    height: 0.5rem;
    background-color: #2563eb; /* brand-accent */
    border-radius: 9999px;
    margin-right: 0.5rem;
  }

  .hero-image-wrapper {
    position: relative;
  }

  .hero-image {
    width: 100%;
    border-radius: 0.5rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .stats-card {
    position: absolute;
    bottom: -1.5rem;
    left: -1.5rem;
    background-color: #ffffff;
    padding: 1rem;
    border-radius: 0.5rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stats-icon-wrapper {
    background-color: #dbeafe; /* blue-100 */
    padding: 0.5rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stats-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: #64748b; /* brand-secondary */
  }

  .stats-text {
    display: flex;
    flex-direction: column;
  }
  .stats-number {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: #0f172a; /* slate-900 */
    margin: 0;
  }
  .stats-label {
    font-size: 0.75rem;
    line-height: 1rem;
    color: #64748b; /* slate-500 */
    margin: 0;
  }

  /* Scroll Reveal animation */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .reveal-on-scroll.revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>
