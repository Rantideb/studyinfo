---
import { Mail, CheckCircle } from "lucide-astro";
---

<section class="newsletter-section">
  <div class="newsletter-container">
    <div class="newsletter-card">
      <div class="icon-header">
        <div class="icon-kicker">NEWSLETTER</div>
      </div>
      
      <h2 class="newsletter-title">STAY UPDATED WITH LATEST TIPS</h2>
      <p class="newsletter-subtitle">
        Get weekly study tips, scholarship alerts, and educational resources delivered to your inbox.
      </p>
      
      <div id="newsletter-form-container">
        <form id="newsletter-form" class="newsletter-form">
          <div class="form-group">
            <input
              type="email"
              id="newsletter-email"
              placeholder="ENTER YOUR EMAIL"
              class="newsletter-input"
              required
            />
            <button type="submit" class="newsletter-button">
              SUBSCRIBE
            </button>
          </div>
          <p class="privacy-note">
            NO SPAM, UNSUBSCRIBE AT ANY TIME.
          </p>
        </form>
      </div>

      <div id="newsletter-success" class="newsletter-success" style="display: none;">
        <CheckCircle class="success-icon" />
        <span class="success-message">THANK YOU FOR SUBSCRIBING!</span>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const formContainer = document.getElementById('newsletter-form-container');
  const successContainer = document.getElementById('newsletter-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
    
    if (emailInput.value) {
      // Simulate success
      if (formContainer) formContainer.style.display = 'none';
      if (successContainer) successContainer.style.display = 'flex';
      
      // You could add a toast here if you want to install a vanilla toast lib, 
      // but keeping it minimal as requested.
    }
  });
</script>

<style>
  .newsletter-section {
    background-color: var(--verge-ultraviolet);
    padding: 4rem 0;
    border-bottom: 1px solid var(--image-frame);
  }
  .newsletter-container {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px) {
    .newsletter-container { padding: 0 1.5rem; }
  }
  @media (min-width: 1024px) {
    .newsletter-container { padding: 0 2rem; }
  }

  .newsletter-card {
    background-color: var(--canvas-black);
    padding: 3rem 2rem;
    border-radius: 0px;
    border: 1px solid var(--hazard-white);
    text-align: center;
  }

  .icon-header {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }
  .icon-kicker {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--jelly-mint);
    letter-spacing: 1.5px;
  }

  .newsletter-title {
    font-family: var(--font-ui);
    font-size: 2.5rem;
    line-height: 1.15;
    letter-spacing: 1.07px;
    color: var(--hazard-white);
    margin-bottom: 1rem;
  }
  .newsletter-subtitle {
    font-family: var(--font-ui);
    font-size: 1.125rem;
    color: var(--muted-text);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .newsletter-form {
    max-width: 28rem;
    margin: 0 auto;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .form-group {
      flex-direction: row;
    }
  }

  .newsletter-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background-color: var(--canvas-black);
    color: var(--hazard-white);
    border: 1px solid var(--image-frame);
    border-radius: 2px;
    font-family: var(--font-ui);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.15s ease;
  }
  .newsletter-input:focus {
    border-color: var(--jelly-mint);
  }

  .newsletter-button {
    padding: 10px 24px;
    background-color: var(--jelly-mint);
    color: var(--inverted-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    border: 1px solid transparent;
    border-radius: 0px;
    letter-spacing: 1.5px;
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .newsletter-button:hover {
    background-color: transparent;
    border-color: var(--jelly-mint);
    color: var(--jelly-mint);
  }

  .privacy-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 1.5px;
    color: var(--secondary-text);
    margin-top: 1rem;
  }

  .newsletter-success {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--jelly-mint);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 1.5px;
  }
  .success-icon {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
