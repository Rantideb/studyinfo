<style>
  .not-found-page {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--canvas-black);
    overflow: hidden;
    padding: 2.5rem 0;
  }
  .not-found-content {
    position: relative;
    z-index: 30;
    width: 100%;
    max-width: 600px;
    text-align: center;
    padding: 0 1rem;
  }
  .svg-wrapper {
    margin-bottom: 2rem;
  }
  .svg-wrapper svg {
    max-width: 100%;
    height: auto;
  }

  .not-found-title {
    font-family: var(--font-ui);
    font-size: 2.5rem;
    letter-spacing: 1.07px;
    line-height: 1.15;
    color: var(--hazard-white);
    margin-bottom: 1rem;
  }
  @media (min-width: 640px) {
    .not-found-title { font-size: 3.5rem; }
  }
  .not-found-text {
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--muted-text);
    margin-bottom: 2rem;
  }
  @media (min-width: 640px) {
    .not-found-text { font-size: 1.25rem; }
  }

  .home-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--jelly-mint);
    color: var(--inverted-text);
    padding: 10px 24px;
    border-radius: 0px;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 1.5px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .home-btn:hover {
    background-color: transparent;
    border-color: var(--jelly-mint);
    color: var(--jelly-mint);
  }

  .not-found-footer {
    margin-top: 4rem;
    color: var(--secondary-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 1.5px;
  }
</style>
