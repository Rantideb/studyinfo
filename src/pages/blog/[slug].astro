---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ShareButton from "../../components/ShareButton.astro";
import { ArrowLeft, Calendar, Clock } from "lucide-astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": data.title,
  "description": data.excerpt,
  "image": data.image,
  "author": {
    "@type": "Person",
    "name": data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Studyinfo",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.studyinfo.net/logo.png"
    }
  },
  "datePublished": data.date,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.studyinfo.net/blog/${post.id}`
  }
};
---

<Layout 
  title={`${data.title} | Studyinfo`}
  description={data.excerpt}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <div class="blog-post-page">
    <div class="container py-12">
      <a href="/blog" class="back-link">
        <ArrowLeft class="back-icon" />
        Back to Articles
      </a>

      <div class="post-header">
        <div class="post-meta-top">
          <span class="category-badge">+ {data.category}</span>
        </div>
        <h1 class="post-title">{data.title}</h1>
      </div>

      <div class="hero-split">
        <div class="hero-image-col">
          <img src={data.image} alt={data.title} class="hero-image" />
          <p class="image-caption">Image: Studyinfo</p>
        </div>
        <div class="hero-info-col">
          <p class="post-excerpt">/ {data.excerpt}</p>
          
          <div class="author-block">
            <p class="author-line">by <span class="author-name">+ {data.author}</span></p>
            <p class="date-line">{data.date} • {data.readTime}</p>
          </div>

          <div class="action-buttons">
            <ShareButton />
          </div>
        </div>
      </div>

      <article class="prose">
        <Content />
      </article>

      <div class="tags-section">
        <h3 class="tags-label">Related Topics</h3>
        <div class="tags-list">
          {data.tags.map((tag: string) => (
            <a href={`/blog?tag=${tag.toLowerCase()}`} class="tag-badge">#{tag}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .blog-post-page {
    background-color: #ffffff;
    color: #000000;
    padding-bottom: 4rem;
  }
  .container {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--verge-ultraviolet);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-decoration: none;
    letter-spacing: 1.5px;
    margin-bottom: 2rem;
  }
  .back-icon {
    width: 1rem;
    height: 1rem;
    margin-right: 0.5rem;
  }

  .post-header {
    margin-bottom: 2rem;
  }
  .post-meta-top {
    margin-bottom: 1rem;
  }
  .category-badge {
    color: var(--verge-ultraviolet);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .post-title {
    font-family: var(--font-ui);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    color: #000000;
  }
  @media (min-width: 768px) {
    .post-title { font-size: 3.5rem; }
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 768px) {
    .hero-split { grid-template-columns: 2fr 1fr; gap: 3rem; }
  }

  .hero-image-col {
    display: flex;
    flex-direction: column;
  }
  .hero-image {
    width: 100%;
    height: auto;
    border: 1px solid #e2e8f0;
  }
  .image-caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #64748b;
    margin-top: 0.5rem;
  }

  .hero-info-col {
    display: flex;
    flex-direction: column;
  }
  .post-excerpt {
    font-family: var(--font-ui);
    font-size: 1.5rem;
    line-height: 1.4;
    color: #334155;
    margin-bottom: 2rem;
  }
  .author-block {
    margin-top: auto;
    margin-bottom: 1.5rem;
  }
  .author-line {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: #000;
    margin: 0 0 0.25rem 0;
  }
  .author-name {
    color: var(--verge-ultraviolet);
    font-weight: 700;
  }
  .date-line {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: #000;
    margin: 0;
  }

  .action-buttons {
    display: flex;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
  }

  .prose {
    font-family: var(--font-ui);
    font-size: 1.125rem;
    line-height: 1.7;
    color: #000000;
    max-width: 48rem;
    margin: 0 auto;
  }

  .tags-section {
    max-width: 48rem;
    margin: 3rem auto 0 auto;
  }
  .tags-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: #000;
    margin-bottom: 1rem;
  }
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .tag-badge {
    padding: 0.25rem 0.75rem;
    background-color: #f8fafc;
    color: #334155;
    border: 1px solid #e2e8f0;
    border-radius: 0px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition: all 0.15s ease;
    display: inline-block;
  }
  .tag-badge:hover {
    background-color: #e2e8f0;
    color: #0f172a;
    transform: translateY(-1px);
  }
</style>
