---
import Layout from "../layouts/Layout.astro";
import { Mail, MessageCircle } from "lucide-astro";
---

<Layout 
  title="Contact Us | Studyinfo"
  description="Get in touch with Study & Scholarship Blog Resources. We are here to help you with your study abroad journey."
>
  <div class="contact-page">
    <div class="container contact-grid">
      <div class="contact-info reveal-on-scroll">
        <h1 class="page-title">
          Let's Talk. <br />
          <span class="text-accent">No Formalities.</span>
        </h1>
        <p class="page-subtitle">
          Confused about where to start? Scared your English isn't good enough? Just ask. We don't care about your grammar; we care about your questions.
        </p>

        <div class="info-list">
          <div class="info-item">
            <div class="info-icon-bg">
              <MessageCircle class="info-icon" />
            </div>
            <div>
              <h3 class="info-heading">WhatsApp Us (Maybe)</h3>
              <p class="info-text">Actually, just email us. We reply fast.</p>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon-bg">
              <Mail class="info-icon" />
            </div>
            <div>
              <h3 class="info-heading">Email Us</h3>
              <p class="info-text">help@studyinfo.net</p>
              <p class="info-subtext">Don't worry about "Dear Sir/Madam". "Hi" is fine.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form-wrapper reveal-on-scroll">
        <form id="contact-form" class="contact-form">
          <div class="form-field">
            <label for="name" class="field-label">Your Name</label>
            <input
              type="text"
              id="name"
              class="field-input"
              placeholder="What should we call you?"
              required
            />
          </div>

          <div class="form-field">
            <label for="email" class="field-label">Email Address</label>
            <input
              type="email"
              id="email"
              class="field-input"
              placeholder="Where can we reply?"
              required
            />
          </div>

          <div class="form-field">
            <label for="status" class="field-label">I am a...</label>
            <select id="status" class="field-select">
              <option value="student">Student (Backbencher)</option>
              <option value="topper">Student (Topper - looking for extra tips)</option>
              <option value="parent">Parent (Worried)</option>
            </select>
          </div>

          <div class="form-field">
            <label for="message" class="field-label">What's on your mind?</label>
            <textarea
              id="message"
              rows="4"
              class="field-textarea"
              placeholder="Ask anything. 'Is Germany actually free?' 'Can I work while studying?'"
              required
            ></textarea>
          </div>

          <button type="submit" class="submit-btn">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initContactAnimations() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thanks for reaching out! We will get back to you soon.');
      form.reset();
    });

    // Intersection Observer for fade-in effect
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
  }

  document.addEventListener('astro:page-load', initContactAnimations);
</script>

<style>
  .contact-page {
    padding: 4rem 0;
    background-color: var(--canvas-black);
  }
  .container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px) {
    .container { padding: 0 1.5rem; }
  }
  @media (min-width: 1024px) {
    .container { padding: 0 2rem; }
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .page-title {
    font-family: var(--font-ui);
    font-size: 2.5rem;
    letter-spacing: 1.07px;
    line-height: 1.15;
    color: var(--hazard-white);
    margin-bottom: 1.5rem;
  }
  .text-accent {
    color: var(--jelly-mint);
  }
  .page-subtitle {
    font-family: var(--font-ui);
    font-size: 1.25rem;
    color: var(--muted-text);
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .info-icon-bg {
    background-color: var(--verge-ultraviolet);
    border: 1px solid var(--image-frame);
    padding: 0.75rem;
    border-radius: 0px;
  }
  .info-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--absolute-white);
  }
  .info-heading {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--hazard-white);
    margin-bottom: 0.25rem;
  }
  .info-text {
    font-family: var(--font-ui);
    color: var(--secondary-text);
  }
  .info-subtext {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-text);
    letter-spacing: 1.5px;
    margin-top: 0.25rem;
  }

  .contact-form-wrapper {
    background-color: var(--canvas-black);
    padding: 2rem;
    border-radius: 0px;
    border: 1px solid var(--image-frame);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .field-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--hazard-white);
    margin-bottom: 0.25rem;
  }
  .field-input, .field-select, .field-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--image-frame);
    border-radius: 2px;
    background-color: var(--canvas-black);
    color: var(--hazard-white);
    font-family: var(--font-ui);
    font-size: 1rem;
    outline: none;
    transition: all 0.2s;
  }
  .field-input:focus, .field-select:focus, .field-textarea:focus {
    border-color: var(--jelly-mint);
  }
  .submit-btn {
    width: 100%;
    background-color: var(--jelly-mint);
    color: var(--inverted-text);
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 0.75rem;
    border: 1px solid transparent;
    border-radius: 0px;
    cursor: pointer;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }
  .submit-btn:hover {
    background-color: transparent;
    border-color: var(--jelly-mint);
    color: var(--jelly-mint);
  }

  /* Reveal animation */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s ease-out;
  }
  .reveal-on-scroll.revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>
